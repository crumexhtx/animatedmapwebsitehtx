# Canonical site URL for metadata, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://mapstoit.com

# CARTO basemap API key (free tier: https://carto.com/basemaps/apikey)
# Safe to expose in the browser — restrict by HTTP referrer in the CARTO dashboard.
# Without this, maps fall back to OpenStreetMap raster tiles (not for heavy production use).
NEXT_PUBLIC_CARTO_API_KEY=your-carto-key-here

# Catalog enrichment (server-side only — never commit real keys)
CENSUS_API_KEY=your-census-api-key-here
FBI_API_KEY=your-data-gov-api-key-here
DATA_GOV_API_KEY=your-data-gov-api-key-here
